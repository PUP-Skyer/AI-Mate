# ========== 青宸智汇 Serverless Proxy 环境变量 ==========

# 服务配置
PORT=3000
NODE_ENV=development

# JWT 密钥（生产环境务必修改！）
JWT_SECRET=your-jwt-secret-change-in-production

# ========== AI API 配置 ==========

# 智谱GLM配置
ZHIPU_API_KEY=your-zhipu-api-key
ZHIPU_MODEL=glm-4-plus
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# Coze配置
COZE_API_KEY=your-coze-api-key
COZE_BOT_ID=your-coze-bot-id
COZE_BASE_URL=https://api.coze.cn/v3

# WorkBuddy MCP配置
WORKBUDDY_MCP_URL=http://localhost:8081/mcp
WORKBUDDY_API_KEY=

# Trae MCP配置
TRAE_MCP_URL=http://localhost:8082/mcp
TRAE_API_KEY=

# ========== 安全配置 ==========

# Prompt防护模式: reject（拒绝）| sanitize（净化，默认）| log（仅记录）
PROMPT_GUARD_MODE=sanitize

# 内容过滤模式: reject（拒绝）| sanitize（净化，默认）| log（仅记录）
CONTENT_FILTER_MODE=sanitize

# 最大内容长度（字符数）
MAX_CONTENT_LENGTH=8000
